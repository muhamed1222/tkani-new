# API Configuration
# Базовый URL для API сервера
# Для разработки используйте локальный сервер
# Для production укажите URL вашего API сервера
VITE_API_URL=http://localhost:5001/api

# Пример для production:
# VITE_API_URL=https://api.yourdomain.com/api

# Strapi URL для работы с изображениями
# URL Strapi CMS (без /api на конце)
VITE_STRAPI_URL=http://localhost:1339

# Пример для production:
# VITE_STRAPI_URL=https://cms.yourdomain.com
